# cp .env.example .env  후 값을 채운다. .env 는 git 에 올리지 않는다.

# ── DB ───────────────────────────────────────────────
DB_NAME=bandroom
DB_USER=bandroom
# 이미 만들어진 DB 볼륨의 비밀번호를 바꾸려면 컨테이너 안에서
#   ALTER USER bandroom WITH PASSWORD '새비번';
# 를 먼저 실행해야 한다. 이 값만 고치면 앱이 DB 에 못 붙는다.
DB_PASSWORD=

# ── 최초 관리자 계정 ──────────────────────────────────
# admin_users 테이블이 비어 있을 때 딱 한 번 쓰인다.
# 계정이 이미 있으면 이 값은 무시된다 (비밀번호 초기화 용도 아님).
INITIAL_ADMIN_USERNAME=superadmin
INITIAL_ADMIN_PASSWORD=

# ── 업로드 ───────────────────────────────────────────
# 티켓 배경 이미지 최대 크기(MB). 0 = 제한 없음.
# 역방향 프록시(nginx)에도 자체 본문 크기 제한이 있으니 그쪽도 같이 봐야 한다.
MAX_UPLOAD_MB=25

# ── pgadmin ──────────────────────────────────────────
# 127.0.0.1:5050 으로만 열린다. 안 쓰면 compose 에서 서비스를 지워도 된다.
PGADMIN_EMAIL=admin@bandroom.com
PGADMIN_PASSWORD=
